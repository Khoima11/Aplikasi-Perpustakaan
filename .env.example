# Salin file ini menjadi .env lalu isi nilainya dari Supabase:
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-public-key

# Nama sekolah yang tampil di bukti peminjaman dan laporan
VITE_NAMA_SEKOLAH=Nama Sekolah

# PERINGATAN: JANGAN PERNAH menaruh service_role key di file ini.
# Service role key hanya disimpan sebagai secret Edge Function di Supabase.
